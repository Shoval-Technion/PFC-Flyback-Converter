D§Schottky N002 out RB578VAM100
Cout out N005 2200µ
Rled out Anode 1k
R1 out Ref 38k
R2 Ref COM 10k
Dclamp Drain N003 ES1D
M§Q1 Drain N007 CS CS BSC190N15NS3
Rsense CS 0 {RsenseVal}
R3 COM 0 100Meg
C1 COM 0 1p
Csnubber N001 N002 1n
Rsnubber out N001 47
R4 Drain N008 47
C2 N008 CS 1n
X§Optocoupler Anode Cathode Collector 0 0 4N25 ;§pnba A)K)C)E)B
Rgate N007 PWM 47
Rpullup Collector OPTO_SENSE 10k
BTON_CMD TON_CMD 0 V=limit(Ton0+Kpton*(Vref-V(Vfb_slow))+Kiton*idt(Vref-V(Vfb_slow)),TonMin,TonMax)
Vst1 Vsaw 0 PULSE(0 10 0 {Ts-100n} 1n 0 {Ts})
B§Vpwm PWM 0 V=if(V(TON_CMD)>V(Vsaw),12,0)
R_LOAD out COM {RloadVal}
R_pulldown N007 0 10k
B§Vadc Vadc 0 V=V(out,COM)*2.5/12
Rcsf CSF CS {RscfVal}
Ccsf CSF 0 {CcsfVal}
Bset SET 0 V=if(V(vsaw)<0.01,1,0)
Breset RESET 0 V=if((V(Vsaw)>V(TON_CMD))+(V(CSF)>VcsLim),1,0)
Vone QSUP 0 1
Sset QSUP Q SET 0 SWLOG
Sreset Q 0 RESET 0 SWLOG
Clatch Q 0 1n
Rq Q 0 10Meg
Bpwm PWM_old 0 V=12*if(V(Q)>0.5,1,0)
VAC AC_L AC_N SINE(0 50 50)
D2 BR_L Vin_rec Dbridge
D3 AC_N Vin_rec Dbridge
D4 0 BR_L Dbridge
D5 0 AC_N Dbridge
X§U1 Cathode COM Ref TL431 ;§pnba CATHODE)ANODE)REF
Rfb Vfb_slow Vadc 100k
Cfb Vfb_slow 0 150n
V§ARDUINO OPTO_SENSE 0 5v
Rser N005 COM 0.05
Rser1 N006 0 0.15
Lf AC_L BR_L 2m Rser=0.3
Cx BR_L AC_N 220n Rser=0.2
Cclamp Vin_rec N003 2.2n
Rclamp Vin_rec N003 47k
S_LOAD out N004 L_ctrl COM SWmod
R_VARYING N004 COM {R_VARYING_Val}
VL_ctrl L_ctrl COM PULSE(0 5 10m 1u 1u 5m 20m)
.model D D
.lib C:\Users\shova\AppData\Local\LTspice\lib\cmp\standard.dio
