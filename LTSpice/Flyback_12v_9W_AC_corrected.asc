TEXT 2208 288 Left 2 !.tran 0 500m 0 100n startup
TEXT 784 1008 Left 2 ;current-sense RC filter
TEXT -1160 592 Left 2 !.model Dbridge D(Is=500n Rs=20m N=1.05 Cjo=40p Bv=100 Ibv=10u)
TEXT 3016 224 Left 2 !.meas TRAN v_rms RMS V(AC_L,AC_N) FROM 460m TO 500m\n.meas TRAN i_rms RMS I(VAC) FROM 460m TO 500m\n.meas TRAN pin_delivered AVG -V(AC_L,AC_N)*I(VAC) FROM 460m TO 500m\n \n.meas TRAN apparent_power PARAM v_rms*i_rms\n.meas TRAN power_factor PARAM abs(pin_delivered/apparent_power)\n \n.meas TRAN vout_avg AVG V(out,COM) FROM 460m TO 500m\n.meas TRAN vout_min MIN V(out,COM) FROM 460m TO 500m\n.meas TRAN vout_max MAX V(out,COM) FROM 460m TO 500m\n \n.meas TRAN pout_formula AVG V(out,COM)*V(out,COM)/RloadVal FROM 460m TO 500m\n.meas TRAN pout_direct AVG V(out,COM)*I(R_LOAD) FROM 460m TO 500m\n \n.meas TRAN vout_start FIND V(out,COM) AT=460m\n.meas TRAN vout_end FIND V(out,COM) AT=500m\n.meas TRAN delta_vout PARAM vout_end-vout_start\n \n.meas TRAN efficiency PARAM pout_formula/pin_delivered
TEXT 3016 848 Left 2 !.meas TRAN vcsf_max MAX V(CSF) FROM 460m TO 500m\n.meas TRAN ipk_max PARAM vcsf_max/RsenseVal
TEXT 3016 1024 Left 2 !.meas TRAN ilf_rms RMS I(Lf) FROM 460m TO 500m\n.meas TRAN icx_rms RMS I(Cx) FROM 460m TO 500m
TEXT 3016 1120 Left 2 !.meas TRAN Psense AVG I(RSENSE)*I(RSENSE)*RsenseVal FROM 460m TO 500m\n.meas TRAN Plf AVG I(Lf)*I(Lf)*0.3 FROM 460m TO 500m\n.meas TRAN Pcx_esr PARAM icx_rms*icx_rms*0.5
TEXT -880 1224 Left 2 ;FEEDBACK
TEXT 2088 1560 Left 2 !.model SWLOG SW(Ron=1 Roff=1G Vt=0.5 Vh=0.1)
TEXT 2544 400 Left 2 !.param Fs=100k\n.param Ts={1/Fs}\n \n.param Lpval=90u\n.param Lsval=12.7u\n.param Kcpl=0.98\n \n.param RloadVal=16\n \n.param Dmin=0.001\n.param Dmax=0.45\n.param D0=0.3\n \n.param Kp=3\n.param Ki=0.1\n.param Vref=2.5\n \n.param RsenseVal=0.14\n \n.param RscfVal=100\n.param CcsfVal=470p\n \n.param Ilim=1.6\n \n.param VcsLim={RsenseVal*Ilim}
