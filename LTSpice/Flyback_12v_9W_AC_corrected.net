Cin Vin_rec N005 125µ Rser=0.15
Lp Drain Vin_rec {Lpval} Rser=1m
Ls N002 COM {Lsval} Rser=1m
D§Schottky N002 out RB578VAM100
Cout out N004 2200µ
Rled out Anode 1k
R1 out Vadc 38k
R2 Vadc COM 10k
Dclamp Drain N003 ES1D
M§Q1 Drain N006 CS CS BSC190N15NS3
Rsense CS 0 {RsenseVal}
R3 COM 0 100Meg
C1 COM 0 1p
Csnubber N001 N002 1n
Rsnubber out N001 47
R4 Drain N007 47
C2 N007 CS 1n
X§Optocoupler Anode Cathode Collector 0 0 4N25 ;§pnba A)K)C)E)B
Rgate N006 PWM 47
Rpullup Collector OPTO_SENSE 10k
R_LOAD out COM {RloadVal}
R_pulldown N006 0 10k
Rcsf CSF CS {RscfVal}
Ccsf CSF 0 {CcsfVal}
VAC AC_L AC_N SINE(0 50 50)
D2 BR_L Vin_rec Dbridge
D3 AC_N Vin_rec Dbridge
D4 0 BR_L Dbridge
D5 0 AC_N Dbridge
X§U1 Cathode COM Vadc TL431 ;§pnba CATHODE)ANODE)REF
V§ARDUINO OPTO_SENSE 0 5v
Rser N004 COM 0.05
Rser1 N005 0 0.15
Lf AC_L BR_L 2m Rser=0.3
Cx BR_L AC_N 220n Rser=0.2
Cclamp Vin_rec N003 2.2n
Rclamp Vin_rec N003 47k
B§Vctrl1 Vctrl 0 V=limit(D0 + Kp*(Vref-V(Vadc)) + Ki*idt(Vref-V(Vadc)), Dmin, Dmax)
Vst2 Vsaw 0 PULSE(0 1 0 {Ts-100n} 1n 0 {Ts})
B§Vadc1 Vadc 0 V=V(out,COM)*2.5/12
Bset1 SET 0 V=if(V(vsaw)<0.01,1,0)
Breset1 RESET 0 V=if((V(vsaw)>V(vctrl))+(V(csf)>VcsLim),1,0)
Vone1 QSUP 0 1
Sset1 QSUP Q SET 0 SWLOG
Sreset1 Q 0 RESET 0 SWLOG
Clatch1 Q 0 1n
Rq1 Q 0 10Meg
Bpwm1 PWM 0 V=12*if(V(Q)>0.5,1,0)
.model D D
.lib C:\Users\shova\AppData\Local\LTspice\lib\cmp\standard.dio
.model NMOS NMOS
.model PMOS PMOS
.lib C:\Users\shova\AppData\Local\LTspice\lib\cmp\standard.mos
K1 Lp Ls {Kcpl}
.tran 0 500m 0 100n startup
* current-sense RC filter
.model Dbridge D(Is=500n Rs=20m N=1.05 Cjo=40p Bv=100 Ibv=10u)
.meas TRAN v_rms RMS V(AC_L,AC_N) FROM 460m TO 500m
.meas TRAN i_rms RMS I(VAC) FROM 460m TO 500m
.meas TRAN pin_delivered AVG -V(AC_L,AC_N)*I(VAC) FROM 460m TO 500m
.meas TRAN apparent_power PARAM v_rms*i_rms
.meas TRAN power_factor PARAM abs(pin_delivered/apparent_power)
.meas TRAN vout_avg AVG V(out,COM) FROM 460m TO 500m
.meas TRAN vout_min MIN V(out,COM) FROM 460m TO 500m
.meas TRAN vout_max MAX V(out,COM) FROM 460m TO 500m
.meas TRAN pout_formula AVG V(out,COM)*V(out,COM)/RloadVal FROM 460m TO 500m
.meas TRAN pout_direct AVG V(out,COM)*I(R_LOAD) FROM 460m TO 500m
.meas TRAN vout_start FIND V(out,COM) AT=460m
.meas TRAN vout_end FIND V(out,COM) AT=500m
.meas TRAN delta_vout PARAM vout_end-vout_start
.meas TRAN efficiency PARAM pout_formula/pin_delivered
.meas TRAN vcsf_max MAX V(CSF) FROM 460m TO 500m
.meas TRAN ipk_max PARAM vcsf_max/RsenseVal
.meas TRAN ilf_rms RMS I(Lf) FROM 460m TO 500m
.meas TRAN icx_rms RMS I(Cx) FROM 460m TO 500m
.meas TRAN Psense AVG I(RSENSE)*I(RSENSE)*RsenseVal FROM 460m TO 500m
.meas TRAN Plf AVG I(Lf)*I(Lf)*0.3 FROM 460m TO 500m
.meas TRAN Pcx_esr PARAM icx_rms*icx_rms*0.5
* FEEDBACK
.model SWLOG SW(Ron=1 Roff=1G Vt=0.5 Vh=0.1)
.param Fs=100k
.param Ts={1/Fs}
.param Lpval=90u
.param Lsval=12.7u
.param Kcpl=0.98
.param RloadVal=16
.param Dmin=0.001
.param Dmax=0.45
.param D0=0.3
.param Kp=3
.param Ki=0.1
.param Vref=2.5
.param RsenseVal=0.14
.param RscfVal=100
.param CcsfVal=470p
.param Ilim=1.6
.param VcsLim={RsenseVal*Ilim}
